WECOM_BOT_ID=your_bot_id_here
WECOM_BOT_SECRET=your_bot_secret_here

# 解密后的 PDF / Word / 图片落盘到这个目录,使用绝对路径
# 留空则用项目根目录下的 inbox/(适合开发测试)
# 例如:ARCHIVE_DIR=D:\VibeCodingProjects\2.1_Project_MeetingMinutes\data\02b_external_notes
ARCHIVE_DIR=

# 公众号抓取是否包含正文中的图片
# 留空 / false → 仅抓文字(默认,推荐;公众号文章里大部分图是广告/二维码,信噪比低)
# true → 把图片也下载并嵌入 DOCX
INCLUDE_IMAGES=

# 文本消息自动落盘为 DOCX 的最低字符数
# 留空则默认 200。低于该值视为短消息(测试/确认/tag),只回执不落盘
# 例如想更严格只存超长笔记:NOTE_MIN_LENGTH=500
NOTE_MIN_LENGTH=

# Tag 配对窗口(秒)。文件落盘后这么久之内发的短文字会被当 tag 重命名该文件
# 留空则默认 300(5 分钟)。例如想给自己更多时间:TAG_WINDOW_SECONDS=600
TAG_WINDOW_SECONDS=
